<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}">
<head>
    {% block head %}
        <meta charset="utf-8" />
        <title>{% if header.title %}{{ header.title|e }} | {% endif %}{{ site.title|e }}</title>
        {% include 'partials/metadata.html.twig' %}
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="{{ url('theme://img/favicon.png') }}" />
        {% if uri.params %}
        <meta name="robots" content="noindex, follow" />
        {% else %}
        <link rel="canonical" href="{{ page.url(true) }}" />
        {% endif %}

        {# Per-page meta description: prefer explicit frontmatter, fall back to
           the page summary (first paragraph before ===), then the site default.
           Without this, every page would inherit site.metadata.description and
           Google would show the same snippet for every result. #}
        {% set page_desc = page.header.metadata.description
            ?: (page.summary|striptags|trim|slice(0, 200))
            ?: site.metadata.description %}
        <meta name="description" content="{{ page_desc|slice(0, 160)|e }}" />

        {# Open Graph image: prefer raster (page.media.images), fall back to the
           first vector (page.media.files where type=vector). SVGs preview on
           LinkedIn/Slack/Discord but not on X, so twitter:card stays `summary`
           unless we have a raster image. A per-page `social_image:` frontmatter
           field overrides everything when an explicit PNG export is shipped. #}
        {% set og_image_url = null %}
        {% set og_image_is_raster = false %}
        {% if page.header.social_image %}
            {% set _override = page.media[page.header.social_image] %}
            {% if _override %}
                {% set og_image_url = base_url_absolute ~ _override.url %}
                {% set og_image_is_raster = (_override.type != 'vector') %}
            {% endif %}
        {% endif %}
        {% if not og_image_url %}
            {% set _raster = page.media.images|first %}
            {% if _raster %}
                {% set og_image_url = base_url_absolute ~ _raster.url %}
                {% set og_image_is_raster = true %}
            {% else %}
                {% for medium in page.media.files if medium.type == 'vector' %}
                    {% if loop.first %}{% set og_image_url = base_url_absolute ~ medium.url %}{% endif %}
                {% endfor %}
            {% endif %}
        {% endif %}

        {# og:title falls back to site.title so the homepage doesn't unfurl as
           "Blog" (which is what page.title resolves to when title: is empty). #}
        <meta property="og:title" content="{% if header.title %}{{ header.title|e }}{% else %}{{ site.title|e }}{% endif %}" />
        <meta property="og:type" content="{% if page.template == 'item' %}article{% else %}website{% endif %}" />
        <meta property="og:url" content="{{ page.url(true) }}" />
        <meta property="og:site_name" content="{{ site.title|e }}" />
        <meta property="og:description" content="{{ page_desc|e }}" />
        {% if og_image_url %}
        <meta property="og:image" content="{{ og_image_url }}" />
        {% endif %}
        {% if og_image_is_raster %}
        <meta name="twitter:image" content="{{ og_image_url }}" />
        <meta name="twitter:card" content="summary_large_image" />
        {% else %}
        <meta name="twitter:card" content="summary" />
        {% endif %}
        <link rel="alternate" type="application/rss+xml" title="{{ site.title|e }}" href="{{ base_url_absolute }}/blog.rss" />

        {# Inline critical CSS so the browser can paint above-the-fold content
           immediately without waiting for the external stylesheet #}
        <style>{{ source('partials/critical.css')|replace({"\n": " "}) }}</style>

        <link rel="preload" href="{{ url('theme://img/' ~ site.intro_avatar ) }}" as="image">
        <link rel="preload" href="{{ url('theme://img/regular.webp') }}" as="image" media="(max-width: 1280px)" fetchpriority="high">
        <link rel="preload" href="{{ url('theme://img/large.webp') }}" as="image" media="(min-width: 1281px)" fetchpriority="high">
        <link rel="preload" href="{{ url('theme://fonts/lato-400-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ url('theme://fonts/open-sans-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ url('theme://fonts/bunchlo.woff') }}" as="font" type="font/woff" crossorigin>
        <link rel="preload" href="{{ url('theme://fonts/fontawesome-webfont.woff?v=4.2.0') }}" as="font" type="font/woff" crossorigin>

        {% block javascripts %}
            {% do assets.addJs('jquery', {priority: 101}) %}
            {% do assets.addJs('theme://js/kube.min.js') %}
        {% endblock %}

        {% block stylesheets %}
            {% do assets.addCss('theme://css/fonts.css', {priority: 110}) %}
            {% do assets.addCss('theme://css/kube.min.css') %}
            {% do assets.addCss('theme://css/font-awesome.min.css') %}
            {% do assets.addCss('theme://css/custom.css') %}
        {% endblock %}

        {# Fonts self-hosted — no external Google Fonts dependency #}

        {# Load the full stylesheet async — critical CSS above covers first paint #}
        {% block assets deferred %}
            {% set css_link = assets.css() %}
            {{ css_link|replace({"rel=\"stylesheet\"": "rel=\"stylesheet\" media=\"print\" onload=\"this.media='all'\""})|raw }}
            <noscript>{{ css_link|raw }}</noscript>
            {{ assets.js()|replace({'<script src=': '<script defer="defer" src='})|raw }}
        {% endblock %}

    {% endblock head%}
</head>
<body class="{{ page.header.body_classes }}">

    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="main-nav">
        <div class="container">
            <header class="group top-nav">
                <nav class="navbar logo-w navbar-left" >
                    <a class="logo" href="{{ home_url }}">{{ site.title|e }}</a>
                </nav>
                <div class="navigation-toggle" data-tools="navigation-toggle" data-target="#navbar-1">
                    <span class="logo">{{ site.title|e }}</span>
                </div>
                {% include 'partials/navigation.html.twig' %}
            </header>
        </div>
    </div>

    <div class="intro">
        <div class="container">
            <div class="units-row">
                <div class="unit-10">
                    <img class="img-intro" src="{{ url('theme://img/' ~ site.intro_avatar ) }}" alt="" width="47" height="47" fetchpriority="high">
                </div>
                <div class="unit-90">
                    <p class="p-intro" lang="ga">{{ site.intro }}</p>
                </div>
            </div>
        </div>
    </div>

    {% block body %}
        <main id="main-content">
        <div class="content">
            <div class="container">
                {% block content %}{% endblock %}
            </div>
        </div>
        </main>
    {% endblock %}

    <footer>
        <div class="container">
            <div class="units-row">
                <div class="unit-50">
                    <p class="text-centered foot-cp">
                        <a href="{{ site.author.url }}">{{ site.author.footer }}</a>
                    </p>
                </div>
                <div class="unit-50">
                    <ul class="social list-flat right">
                        {% for item in site.social %}
                            <li><a href="{{ item.link }}" aria-label="{{ item.icon|capitalize }}"><i class="fa fa-{{ item.icon }}" aria-hidden="true"></i></a></li>
                        {% endfor %}
                    </ul>
                </div>
                <p class="text-centered foot-cp">
                    <a href="{{ site.author.url2}}">{{ site.author.footer2 }}</a>
                </p>
            </div>
        </div>
    </footer>

    {{ assets.js('bottom')|replace({'<script src=': '<script defer="defer" src='})|raw }}
</body>
</html>
